{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenDota": {
    "BaseUrl": "https://api.opendota.com/",
    "SteamCdnBaseUrl": "https://cdn.cloudflare.steamstatic.com",
    "MatchupRequestDelayMs": 1100
  },
  "Matchups": {
    "Source": "Public",
    "WindowSize": 200000,
    "WindowCount": 15
  },
  "Counters": {
    "PriorGames": 30
  }
}

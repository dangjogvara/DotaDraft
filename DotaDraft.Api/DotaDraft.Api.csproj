<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
      <UserSecretsId>a2ef6fd5-501f-4ca6-b848-641c3a52f4a9</UserSecretsId>
        <!-- Puts /// comments on endpoints, DTOs and options into the OpenAPI document -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- Not every public member or parameter needs a doc comment -->
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
    </ItemGroup>

    <!--
        dotnet publish also builds the Angular app and ships it in wwwroot, where the API serves it (see
        UseStaticFiles in Program.cs). Builds and tests don't, so they don't need Node.
        Skip it with -p:SkipAngularBuild=true when publishing the API on its own.
    -->
    <PropertyGroup>
        <AngularRoot>$(MSBuildProjectDirectory)/../DotaDraft.Web/</AngularRoot>
        <AngularOutput>$(AngularRoot)dist/dotadraft-web/browser/</AngularOutput>
    </PropertyGroup>

    <Target Name="PublishAngularApp" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipAngularBuild)' != 'true'">
        <Exec WorkingDirectory="$(AngularRoot)" Command="npm ci" />
        <Exec WorkingDirectory="$(AngularRoot)" Command="npx ng build" />
        <ItemGroup>
            <AngularFiles Include="$(AngularOutput)**" />
            <ResolvedFileToPublish Include="@(AngularFiles->'%(FullPath)')">
                <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

</Project>
